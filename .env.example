# ==============================================================================
# SALUD FORTE — CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones: Duplique este archivo como ".env" y configure las variables reales.
# Deje las variables vacías en entornos de demostración y desarrollo local.
# ==============================================================================

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE SUPABASE (AUTENTICACIÓN Y BASE DE DATOS)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase
VITE_SUPABASE_URL=

# Llave anónima pública de Supabase
VITE_SUPABASE_ANON_KEY=

# Llave de rol de servicio (Service Role Key) para uso exclusivo en backend
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# CLAVES DE INTELIGENCIA ARTIFICIAL (GEMINI API)
# ------------------------------------------------------------------------------
# Token de acceso para la API de Gemini. 
# AI Studio lo inyecta automáticamente si está configurado en los Secretos de la consola.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# URL DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# La URL base donde se encuentra alojada la aplicación de forma pública.
# Inyectado automáticamente por AI Studio en entornos de Cloud Run.
APP_URL=

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE TIENDA Y APP SHOPIFY
# ------------------------------------------------------------------------------
# Dominio oficial de la tienda en Shopify (ejemplo: mi-tienda.myshopify.com)
SHOPIFY_SHOP_DOMAIN=

# Token de acceso público a la API Storefront de Shopify (para consultas de carrito y catálogo)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# API Key (Client ID) de tu Partner App de Shopify
SHOPIFY_API_KEY=

# API Secret de tu Partner App de Shopify
SHOPIFY_API_SECRET=

# Scopes de acceso requeridos para la Academia
SHOPIFY_SCOPES=

# URL de la aplicación registrada en el panel de Shopify Partners
SHOPIFY_APP_URL=

# Firma secreta para validación de Webhooks oficiales recibidos de Shopify
SHOPIFY_WEBHOOK_SECRET=

# Clave secreta para cifrado de sesiones y cookies del cliente (32 caracteres)
APP_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE CLOUDFLARE STREAM (VIDEO SEGURO)
# ------------------------------------------------------------------------------
# ID de la cuenta de Cloudflare para acceso a la API de Stream
CLOUDFLARE_ACCOUNT_ID=

# Token de API de Cloudflare con permisos de lectura y escritura para Stream
CLOUDFLARE_STREAM_API_TOKEN=

# ID de la llave de firma generada en el panel de Cloudflare Stream
CLOUDFLARE_STREAM_KEY_ID=

# Llave privada en formato PEM o JWK utilizada para firmar los tokens de reproducción segura
CLOUDFLARE_STREAM_PRIVATE_KEY=

# Dominios autorizados para restringir la reproducción de los videos firmados (separados por comas)
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE CORREOS TRANSACCIONALES (RESEND)
# ------------------------------------------------------------------------------
# API Key de Resend (obtenida de resend.com)
RESEND_API_KEY=

# Dirección de correo electrónico autorizada para enviar los correos (ej. hola@tudominio.com)
EMAIL_FROM_ADDRESS=

# Nombre del remitente que se mostrará al destinatario (ej. Dr. Mauricio Galindo | Salud Forte)
EMAIL_FROM_NAME=


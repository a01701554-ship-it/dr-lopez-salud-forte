{% comment %}
  Aviso Médico y Ético - Academia Salud Forte (Shopify Section)
{% endcomment %}

<section class="academy-disclaimer py-10 bg-[#E9E6DF]/50 border-t border-[#B39A6A]/20">
  <div class="max-w-[880px] mx-auto px-5">
    <div class="flex items-start gap-3.5 p-5 rounded-2xl bg-white border border-[#B39A6A]/25 text-xs text-[#111820]/80">
      <svg class="w-5 h-5 text-[#B39A6A] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <strong class="block text-sm text-[#111820] font-semibold mb-1">
          Aviso de Responsabilidad Médica y Ética
        </strong>
        <p class="leading-relaxed">
          {{ section.settings.disclaimer_text | default: "El contenido de esta masterclass tiene fines exclusivamente educativos e informativos. No sustituye una consulta, diagnóstico o tratamiento médico individual. Ante síntomas, dudas o decisiones relacionadas con tu salud, consulta a un profesional calificado." }}
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aviso Médico Ético",
  "settings": [
    {
      "type": "textarea",
      "id": "disclaimer_text",
      "label": "Texto del descargo médico",
      "default": "El contenido de esta masterclass tiene fines exclusivamente educativos e informativos. No sustituye una consulta, diagnóstico o tratamiento médico individual. Ante síntomas, dudas o decisiones relacionadas con tu salud, consulta a un profesional calificado."
    }
  ],
  "presets": [
    {
      "name": "Aviso Médico Ético"
    }
  ]
}
{% endschema %}
